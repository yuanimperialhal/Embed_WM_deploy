#!/bin/sh
set -eu
case "${1:-}" in
  install|upgrade)
    if [ ! -r /etc/os-release ]; then
      echo 'Cosmos Camera requires Ubuntu 22.04 on Jetson Orin.' >&2
      exit 1
    fi
    . /etc/os-release
    if [ "${ID:-}" != ubuntu ] || [ "${VERSION_ID:-}" != 22.04 ]; then
      echo 'Cosmos Camera requires Ubuntu 22.04 / JetPack 6 / L4T R36.4.x.' >&2
      exit 1
    fi
    if [ ! -r /etc/nv_tegra_release ] || ! grep -q '^# R36 .*REVISION: 4\.' /etc/nv_tegra_release; then
      echo 'Cosmos Camera requires Jetson Linux L4T R36.4.x; install matching JetPack first.' >&2
      exit 1
    fi
    ;;
esac
exit 0
